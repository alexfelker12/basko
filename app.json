{
  "expo": {
    "name": "Basko",
    "slug": "basko",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "basko",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router", ["expo-splash-screen", {}]],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
