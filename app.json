{
  "expo": {
    "name": "Basko",
    "slug": "basko",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "basko",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.alexfelker.basko",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "file",
              "mimeType": "application/x-basko"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-basko"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.basko"
            },
            {
              "scheme": "content",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.basko"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "file",
              "mimeType": "application/x-basko-backup"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-basko-backup"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.baskobackup"
            },
            {
              "scheme": "content",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.baskobackup"
            }
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "BaskoList",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "com.alexfelker.basko.list"
            ]
          },
          {
            "CFBundleTypeName": "BaskoBackup",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "com.alexfelker.basko.backup"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.alexfelker.basko.list",
            "UTTypeDescription": "BaskoList",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "basko"
              ],
              "public.mime-type": "application/x-basko"
            }
          },
          {
            "UTTypeIdentifier": "com.alexfelker.basko.backup",
            "UTTypeDescription": "BaskoBackup",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "baskobackup"
              ],
              "public.mime-type": "application/x-basko-backup"
            }
          }
        ],
        "NSLocalNetworkUsageDescription": "Basko looks for devices on the same Wi-Fi to send and receive shopping lists directly.",
        "CFBundleAllowMixedLocalizations": true,
        "NSBonjourServices": [
          "_basko._tcp"
        ]
      }
    },
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Basko needs access to your photos so you can add pictures to products.",
          "cameraPermission": "Basko needs the camera so you can take photos of products.",
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/manrope/500Medium/Manrope_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/manrope/600SemiBold/Manrope_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/manrope/800ExtraBold/Manrope_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/manrope/500Medium/Manrope_500Medium.ttf",
              "./node_modules/@expo-google-fonts/manrope/600SemiBold/Manrope_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf",
              "./node_modules/@expo-google-fonts/manrope/800ExtraBold/Manrope_800ExtraBold.ttf"
            ]
          }
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4EE",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#1B1E19"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71ee0bc0-63b7-4e5a-b817-2119f6ae04ee"
      }
    },
    "owner": "alexfelker"
  }
}
