{
  "expo": {
    "name": "Basko",
    "slug": "basko",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "basko",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.alexfelker.basko",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "file",
              "mimeType": "application/x-basko"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-basko"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.basko"
            },
            {
              "scheme": "content",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.basko"
            }
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Digi List",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "com.alexfelker.basko.list"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.alexfelker.basko.list",
            "UTTypeDescription": "Digi List",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "basko"
              ]
            }
          }
        ]
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71ee0bc0-63b7-4e5a-b817-2119f6ae04ee"
      }
    },
    "owner": "alexfelker"
  }
}
